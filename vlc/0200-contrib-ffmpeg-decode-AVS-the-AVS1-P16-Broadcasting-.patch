From dc759c58ff709f07377a7e6c4f6ce1c3fc6ad52c Mon Sep 17 00:00:00 2001
Message-Id: <dc759c58ff709f07377a7e6c4f6ce1c3fc6ad52c.1793850990.git.kangzjnet@gmail.com>
From: Jasper Kang <kangzjnet@gmail.com>
Date: Thu, 5 Nov 2026 16:56:30 +1300
Subject: [PATCH] contrib: ffmpeg: decode AVS+, the AVS1-P16 Broadcasting
 profile

FFmpeg 4.4's cavs decoder takes the JiZhun profile only, so the AVS+ that
China's DTMB and cable channels carry decodes to nothing. avsplus.patch
backports FFmpeg master's decoder (c37ebc8d98) onto 4.4.5.

Message-Id: <dc759c58ff709f07377a7e6c4f6ce1c3fc6ad52c.1793850990.git.kangzjnet@gmail.com>
---
 contrib/src/ffmpeg/avsplus.patch | 3083 ++++++++++++++++++++++++++++++
 contrib/src/ffmpeg/rules.mak     |    1 +
 2 files changed, 3084 insertions(+)
 create mode 100644 contrib/src/ffmpeg/avsplus.patch

diff --git a/contrib/src/ffmpeg/avsplus.patch b/contrib/src/ffmpeg/avsplus.patch
new file mode 100644
index 0000000000..6c3ab56550
--- /dev/null
+++ b/contrib/src/ffmpeg/avsplus.patch
@@ -0,0 +1,3083 @@
+avcodec/cavsdec: decode AVS1-P16, the Broadcasting profile (AVS+)
+
+FFmpeg's own decoder, backported from master onto 4.4.5: cavs.c, cavs.h,
+cavs_aec.c, cavs_aec.h, cavsdata.c and cavsdec.c as they are at c37ebc8d98
+("avcodec/cavsdec: accept the AVS1-P16 Broadcasting profile", the last of
+Rainbaby's 19 commits ending there), cavsdsp kept as 4.4.5 has it, and
+cavs_compat.h for what 4.4 lacks (av_fallthrough, FF_SIGNBIT, the profile
+numbers, ff_permute_scantable, put_bytes_output). The codec is registered
+the 4.4 way and the frame's interlacing is set through 4.4's fields.
+
+It decodes fate-cavs-avsplus bit-exact to master's reference, and fate-cavs
+and fate-cavs-bunny exactly as 4.4.5 did.
+---
+diff --git a/libavcodec/Makefile b/libavcodec/Makefile
+index b3d284d..2ada860 100644
+--- a/libavcodec/Makefile
++++ b/libavcodec/Makefile
+@@ -253,7 +253,7 @@ OBJS-$(CONFIG_BMV_VIDEO_DECODER)       += bmvvideo.o
+ OBJS-$(CONFIG_BRENDER_PIX_DECODER)     += brenderpix.o
+ OBJS-$(CONFIG_C93_DECODER)             += c93.o
+ OBJS-$(CONFIG_CAVS_DECODER)            += cavs.o cavsdec.o cavsdsp.o \
+-                                          cavsdata.o
++                                          cavsdata.o cavs_aec.o
+ OBJS-$(CONFIG_CCAPTION_DECODER)        += ccaption_dec.o ass.o
+ OBJS-$(CONFIG_CDGRAPHICS_DECODER)      += cdgraphics.o
+ OBJS-$(CONFIG_CDTOONS_DECODER)         += cdtoons.o
+diff --git a/libavcodec/cavs.c b/libavcodec/cavs.c
+index 74b8371..429f359 100644
+--- a/libavcodec/cavs.c
++++ b/libavcodec/cavs.c
+@@ -1,5 +1,5 @@
+ /*
+- * Chinese AVS video (AVS1-P2, JiZhun profile) decoder.
++ * Chinese AVS video (AVS1-P2/P16, JiZhun and Broadcasting profiles) decoder.
+  * Copyright (c) 2006  Stefan Gehrer <stefan.gehrer@gmx.de>
+  *
+  * This file is part of FFmpeg.
+@@ -21,18 +21,15 @@
+ 
+ /**
+  * @file
+- * Chinese AVS video (AVS1-P2, JiZhun profile) decoder
++ * Chinese AVS video (AVS1-P2/P16, JiZhun and Broadcasting profiles) decoder
+  * @author Stefan Gehrer <stefan.gehrer@gmx.de>
+  */
+ 
+-#include "libavutil/mem_internal.h"
+-
++#include "libavutil/mem.h"
+ #include "avcodec.h"
+-#include "get_bits.h"
+ #include "golomb.h"
+ #include "h264chroma.h"
+ #include "idctdsp.h"
+-#include "internal.h"
+ #include "mathops.h"
+ #include "qpeldsp.h"
+ #include "cavs.h"
+@@ -60,7 +57,18 @@ static const uint8_t tc_tab[64] = {
+ 
+ /** mark block as unavailable, i.e. out of picture
+  *  or not yet decoded */
+-static const cavs_vector un_mv = { 0, 0, 1, NOT_AVAIL };
++static const cavs_vector un_mv = { 0, 0, 1, NOT_AVAIL, 0 };
++
++/**
++ * Inverse block scan method 2 (clause 9.5.3 c), figure 23), for field
++ * coded pictures, as the inverse ff_permute_scantable() expects.
++ */
++static const uint8_t cavs_scan_field[64] = {
++     0,  8, 16,  1, 24, 32,  9, 17, 40, 48, 25,  2, 10, 56, 33, 18,
++     3, 41, 49, 26, 11, 19,  4, 57, 34, 12, 42, 27, 20, 50, 35, 28,
++     5, 13, 58, 43, 36, 21,  6, 29, 51, 44, 14, 22, 37, 59, 52, 30,
++    45, 60, 38, 53, 46, 61, 54,  7, 62, 15, 23, 31, 39, 47, 55, 63,
++};
+ 
+ static const int8_t left_modifier_l[8] = {  0, -1,  6, -1, -1, 7, 6, 7 };
+ static const int8_t top_modifier_l[8]  = { -1,  1,  5, -1, -1, 5, 7, 7 };
+@@ -389,29 +397,36 @@ void ff_cavs_modify_mb_i(AVSContext *h, int *pred_mode_uv)
+  *
+  ****************************************************************************/
+ 
+-static inline void mc_dir_part(AVSContext *h, AVFrame *pic, int chroma_height,
+-                               int delta, int list, uint8_t *dest_y,
++static inline void mc_dir_part(AVSContext *h, AVFrame *pic, int parity,
++                               int chroma_height,
++                               int list, uint8_t *dest_y,
+                                uint8_t *dest_cb, uint8_t *dest_cr,
+                                int src_x_offset, int src_y_offset,
+                                qpel_mc_func *qpix_op,
+                                h264_chroma_mc_func chroma_op, cavs_vector *mv)
+ {
++    if (!pic->data[0])
++        return;
++
+     const int mx         = mv->x + src_x_offset * 8;
+     const int my         = mv->y + src_y_offset * 8;
+     const int luma_xy    = (mx & 3) + ((my & 3) << 2);
+-    uint8_t *src_y       = pic->data[0] + (mx >> 2) + (my >> 2) * h->l_stride;
+-    uint8_t *src_cb      = pic->data[1] + (mx >> 3) + (my >> 3) * h->c_stride;
+-    uint8_t *src_cr      = pic->data[2] + (mx >> 3) + (my >> 3) * h->c_stride;
++    uint8_t *src_y       = pic->data[0] + parity * pic->linesize[0] +
++                           (mx >> 2) + (my >> 2) * h->l_stride;
++    uint8_t *src_cb      = pic->data[1] + parity * pic->linesize[1] +
++                           (mx >> 3) + (my >> 3) * h->c_stride;
++    uint8_t *src_cr      = pic->data[2] + parity * pic->linesize[2] +
++                           (mx >> 3) + (my >> 3) * h->c_stride;
+     int extra_width      = 0;
+     int extra_height     = extra_width;
+     const int full_mx    = mx >> 2;
+     const int full_my    = my >> 2;
+     const int pic_width  = 16 * h->mb_width;
+-    const int pic_height = 16 * h->mb_height;
++    /* motion vectors address a field in quarter field lines (9.9.2.1) */
++    const int pic_height = h->pic_structure ? 16 * h->mb_height
++                                            :  8 * h->mb_height;
+     int emu = 0;
+ 
+-    if (!pic->data[0])
+-        return;
+     if (mx & 7)
+         extra_width  -= 3;
+     if (my & 7)
+@@ -455,7 +470,7 @@ static inline void mc_dir_part(AVSContext *h, AVFrame *pic, int chroma_height,
+     chroma_op(dest_cr, src_cr, h->c_stride, chroma_height, mx & 7, my & 7);
+ }
+ 
+-static inline void mc_part_std(AVSContext *h, int chroma_height, int delta,
++static inline void mc_part_std(AVSContext *h, int chroma_height,
+                                uint8_t *dest_y,
+                                uint8_t *dest_cb,
+                                uint8_t *dest_cr,
+@@ -473,11 +488,12 @@ static inline void mc_part_std(AVSContext *h, int chroma_height, int delta,
+     dest_cb  += x_offset     + y_offset * h->c_stride;
+     dest_cr  += x_offset     + y_offset * h->c_stride;
+     x_offset += 8 * h->mbx;
+-    y_offset += 8 * h->mby;
++    /* the row is counted inside the current field (clause 3.24) */
++    y_offset += 8 * h->field_mby;
+ 
+     if (mv->ref >= 0) {
+-        AVFrame *ref = h->DPB[mv->ref].f;
+-        mc_dir_part(h, ref, chroma_height, delta, 0,
++        mc_dir_part(h, h->ref[mv->ref].f, h->ref[mv->ref].parity,
++                    chroma_height, 0,
+                     dest_y, dest_cb, dest_cr, x_offset, y_offset,
+                     qpix_op, chroma_op, mv);
+ 
+@@ -485,43 +501,44 @@ static inline void mc_part_std(AVSContext *h, int chroma_height, int delta,
+         chroma_op = chroma_avg;
+     }
+ 
+-    if ((mv + MV_BWD_OFFS)->ref >= 0) {
+-        AVFrame *ref = h->DPB[0].f;
+-        mc_dir_part(h, ref, chroma_height, delta, 1,
++    mv += MV_BWD_OFFS;
++    if (mv->ref >= 0) {
++        mc_dir_part(h, h->ref[mv->ref].f, h->ref[mv->ref].parity,
++                    chroma_height, 1,
+                     dest_y, dest_cb, dest_cr, x_offset, y_offset,
+-                    qpix_op, chroma_op, mv + MV_BWD_OFFS);
++                    qpix_op, chroma_op, mv);
+     }
+ }
+ 
+ void ff_cavs_inter(AVSContext *h, enum cavs_mb mb_type)
+ {
+     if (ff_cavs_partition_flags[mb_type] == 0) { // 16x16
+-        mc_part_std(h, 8, 0, h->cy, h->cu, h->cv, 0, 0,
++        mc_part_std(h, 8, h->cy, h->cu, h->cv, 0, 0,
+                     h->cdsp.put_cavs_qpel_pixels_tab[0],
+                     h->h264chroma.put_h264_chroma_pixels_tab[0],
+                     h->cdsp.avg_cavs_qpel_pixels_tab[0],
+                     h->h264chroma.avg_h264_chroma_pixels_tab[0],
+                     &h->mv[MV_FWD_X0]);
+     } else {
+-        mc_part_std(h, 4, 0, h->cy, h->cu, h->cv, 0, 0,
++        mc_part_std(h, 4, h->cy, h->cu, h->cv, 0, 0,
+                     h->cdsp.put_cavs_qpel_pixels_tab[1],
+                     h->h264chroma.put_h264_chroma_pixels_tab[1],
+                     h->cdsp.avg_cavs_qpel_pixels_tab[1],
+                     h->h264chroma.avg_h264_chroma_pixels_tab[1],
+                     &h->mv[MV_FWD_X0]);
+-        mc_part_std(h, 4, 0, h->cy, h->cu, h->cv, 4, 0,
++        mc_part_std(h, 4, h->cy, h->cu, h->cv, 4, 0,
+                     h->cdsp.put_cavs_qpel_pixels_tab[1],
+                     h->h264chroma.put_h264_chroma_pixels_tab[1],
+                     h->cdsp.avg_cavs_qpel_pixels_tab[1],
+                     h->h264chroma.avg_h264_chroma_pixels_tab[1],
+                     &h->mv[MV_FWD_X1]);
+-        mc_part_std(h, 4, 0, h->cy, h->cu, h->cv, 0, 4,
++        mc_part_std(h, 4, h->cy, h->cu, h->cv, 0, 4,
+                     h->cdsp.put_cavs_qpel_pixels_tab[1],
+                     h->h264chroma.put_h264_chroma_pixels_tab[1],
+                     h->cdsp.avg_cavs_qpel_pixels_tab[1],
+                     h->h264chroma.avg_h264_chroma_pixels_tab[1],
+                     &h->mv[MV_FWD_X2]);
+-        mc_part_std(h, 4, 0, h->cy, h->cu, h->cv, 4, 4,
++        mc_part_std(h, 4, h->cy, h->cu, h->cv, 4, 4,
+                     h->cdsp.put_cavs_qpel_pixels_tab[1],
+                     h->h264chroma.put_h264_chroma_pixels_tab[1],
+                     h->cdsp.avg_cavs_qpel_pixels_tab[1],
+@@ -585,6 +602,9 @@ void ff_cavs_mv(AVSContext *h, enum cavs_mv_loc nP, enum cavs_mv_loc nC,
+ 
+     mvP->ref  = ref;
+     mvP->dist = h->dist[mvP->ref];
++    /* a derived reference has index 0 (clause 9.4.5) */
++    if (mode >= MV_PRED_PSKIP)
++        mvP->ref_idx = 0;
+     if (mvC->ref == NOT_AVAIL || (nP == MV_FWD_X3) || (nP == MV_BWD_X3 ))
+         mvC = &h->mv[nP - 5];  // set to top-left (mvD)
+     if (mode == MV_PRED_PSKIP &&
+@@ -614,8 +634,20 @@ void ff_cavs_mv(AVSContext *h, enum cavs_mv_loc nP, enum cavs_mv_loc nC,
+         mv_pred_median(h, mvP, mvA, mvB, mvC);
+ 
+     if (mode < MV_PRED_PSKIP) {
+-        int mx = get_se_golomb(&h->gb) + (unsigned)mvP->x;
+-        int my = get_se_golomb(&h->gb) + (unsigned)mvP->y;
++        int dx, dy, mx, my;
++
++        /* under AEC mv_diff is already in the cache (aec_mv() in cavsdec.c) */
++        if (h->aec_enable) {
++            dx = h->mvd[nP][0];
++            dy = h->mvd[nP][1];
++        } else {
++            dx = get_se_golomb(&h->gb);
++            dy = get_se_golomb(&h->gb);
++            h->mvd[nP][0] = dx;
++            h->mvd[nP][1] = dy;
++        }
++        mx = dx + (unsigned)mvP->x;
++        my = dy + (unsigned)mvP->y;
+ 
+         if (mx != (int16_t)mx || my != (int16_t)my) {
+             av_log(h->avctx, AV_LOG_ERROR, "MV %d %d out of supported range\n", mx, my);
+@@ -623,6 +655,7 @@ void ff_cavs_mv(AVSContext *h, enum cavs_mv_loc nP, enum cavs_mv_loc nC,
+             mvP->x = mx;
+             mvP->y = my;
+         }
++        set_mvds(&h->mvd[nP], size);
+     }
+     set_mvs(mvP, size);
+ }
+@@ -633,6 +666,30 @@ void ff_cavs_mv(AVSContext *h, enum cavs_mv_loc nP, enum cavs_mv_loc nC,
+  *
+  ****************************************************************************/
+ 
++/**
++ * Point the macroblock sample pointers at macroblock row h->mby, addressed
++ * inside the macroblock's own field at the doubled stride (clause 7.2.3.1).
++ */
++void ff_cavs_set_mb_row(AVSContext *h)
++{
++    int parity = 0;
++
++    h->field     = !h->pic_structure && h->mby >= h->mb_height / 2;
++    h->field_mby = h->mby - h->field * (h->mb_height / 2);
++    /* the first row of a field has nothing above it */
++    if (!h->field_mby)
++        h->flags &= ~(B_AVAIL | C_AVAIL | D_AVAIL);
++    if (!h->pic_structure)
++        parity = h->field ^ !h->top_field_first;
++
++    h->cy = h->cur.f->data[0] + parity * h->cur.f->linesize[0] +
++            h->field_mby * 16 * h->l_stride;
++    h->cu = h->cur.f->data[1] + parity * h->cur.f->linesize[1] +
++            h->field_mby *  8 * h->c_stride;
++    h->cv = h->cur.f->data[2] + parity * h->cur.f->linesize[2] +
++            h->field_mby *  8 * h->c_stride;
++}
++
+ /**
+  * initialise predictors for motion vectors and intra prediction
+  */
+@@ -640,6 +697,11 @@ void ff_cavs_init_mb(AVSContext *h)
+ {
+     int i;
+ 
++    /* a macroblock has no mv_diff until one is decoded for it */
++    memset(h->mvd[MV_FWD_X0], 0, 2 * sizeof(*h->mvd));
++    memset(h->mvd[MV_FWD_X2], 0, 2 * sizeof(*h->mvd));
++    memset(h->mvd[MV_BWD_X0], 0, 2 * sizeof(*h->mvd));
++    memset(h->mvd[MV_BWD_X2], 0, 2 * sizeof(*h->mvd));
+     /* copy predictors from top line (MB B and C) into cache */
+     for (i = 0; i < 3; i++) {
+         h->mv[MV_FWD_B2 + i] = h->top_mv[0][h->mbx * 2 + i];
+@@ -686,8 +748,10 @@ int ff_cavs_next_mb(AVSContext *h)
+     h->cu    += 8;
+     h->cv    += 8;
+     /* copy mvs as predictors to the left */
+-    for (i = 0; i <= 20; i += 4)
++    for (i = 0; i <= 20; i += 4) {
+         h->mv[i] = h->mv[i + 2];
++        memcpy(h->mvd[i], h->mvd[i + 2], sizeof(*h->mvd));
++    }
+     /* copy bottom mvs from cache to top line */
+     h->top_mv[0][h->mbx * 2 + 0] = h->mv[MV_FWD_X2];
+     h->top_mv[0][h->mbx * 2 + 1] = h->mv[MV_FWD_X3];
+@@ -701,17 +765,17 @@ int ff_cavs_next_mb(AVSContext *h)
+         /* clear left pred_modes */
+         h->pred_mode_Y[3] = h->pred_mode_Y[6] = NOT_AVAIL;
+         /* clear left mv predictors */
+-        for (i = 0; i <= 20; i += 4)
++        for (i = 0; i <= 20; i += 4) {
+             h->mv[i] = un_mv;
++            memset(h->mvd[i], 0, sizeof(*h->mvd));
++        }
+         h->mbx = 0;
+         h->mby++;
+-        /* re-calculate sample pointers */
+-        h->cy = h->cur.f->data[0] + h->mby * 16 * h->l_stride;
+-        h->cu = h->cur.f->data[1] + h->mby * 8 * h->c_stride;
+-        h->cv = h->cur.f->data[2] + h->mby * 8 * h->c_stride;
+         if (h->mby == h->mb_height) { // Frame end
+             return 0;
+         }
++        /* re-calculate sample pointers */
++        ff_cavs_set_mb_row(h);
+     }
+     return 1;
+ }
+@@ -727,22 +791,23 @@ int ff_cavs_init_pic(AVSContext *h)
+     int i;
+ 
+     /* clear some predictors */
+-    for (i = 0; i <= 20; i += 4)
++    for (i = 0; i <= 20; i += 4) {
+         h->mv[i] = un_mv;
+-    h->mv[MV_BWD_X0] = ff_cavs_dir_mv;
++        memset(h->mvd[i], 0, sizeof(*h->mvd));
++    }
++    h->mv[MV_BWD_X0] = CAVS_DIR_MV;
+     set_mvs(&h->mv[MV_BWD_X0], BLK_16X16);
+-    h->mv[MV_FWD_X0] = ff_cavs_dir_mv;
++    h->mv[MV_FWD_X0] = CAVS_DIR_MV;
+     set_mvs(&h->mv[MV_FWD_X0], BLK_16X16);
+     h->pred_mode_Y[3] = h->pred_mode_Y[6] = NOT_AVAIL;
+-    h->cy             = h->cur.f->data[0];
+-    h->cu             = h->cur.f->data[1];
+-    h->cv             = h->cur.f->data[2];
+-    h->l_stride       = h->cur.f->linesize[0];
+-    h->c_stride       = h->cur.f->linesize[1];
++    /* a field is every other line of the frame (clause 6.1.2) */
++    h->l_stride       = h->cur.f->linesize[0] << !h->pic_structure;
++    h->c_stride       = h->cur.f->linesize[1] << !h->pic_structure;
+     h->luma_scan[2]   = 8 * h->l_stride;
+     h->luma_scan[3]   = 8 * h->l_stride + 8;
+     h->mbx            = h->mby = h->mbidx = 0;
+     h->flags          = 0;
++    ff_cavs_set_mb_row(h);
+ 
+     return 0;
+ }
+@@ -762,23 +827,30 @@ int ff_cavs_init_top_lines(AVSContext *h)
+ {
+     /* alloc top line of predictors */
+     h->top_qp       = av_mallocz(h->mb_width);
+-    h->top_mv[0]    = av_mallocz_array(h->mb_width * 2 + 1,  sizeof(cavs_vector));
+-    h->top_mv[1]    = av_mallocz_array(h->mb_width * 2 + 1,  sizeof(cavs_vector));
+-    h->top_pred_Y   = av_mallocz_array(h->mb_width * 2,  sizeof(*h->top_pred_Y));
+-    h->top_border_y = av_mallocz_array(h->mb_width + 1,  16);
+-    h->top_border_u = av_mallocz_array(h->mb_width,  10);
+-    h->top_border_v = av_mallocz_array(h->mb_width,  10);
++    h->top_mv[0]    = av_calloc(h->mb_width * 2 + 1,  sizeof(cavs_vector));
++    h->top_mv[1]    = av_calloc(h->mb_width * 2 + 1,  sizeof(cavs_vector));
++    h->top_pred_Y   = av_calloc(h->mb_width * 2,  sizeof(*h->top_pred_Y));
++    h->top_border_y = av_calloc(h->mb_width + 1,  16);
++    h->top_border_u = av_calloc(h->mb_width,  10);
++    h->top_border_v = av_calloc(h->mb_width,  10);
+ 
+     /* alloc space for co-located MVs and types */
+-    h->col_mv        = av_mallocz_array(h->mb_width * h->mb_height,
+-                                        4 * sizeof(cavs_vector));
++    h->col_mv        = av_calloc(h->mb_width * h->mb_height,
++                                 4 * sizeof(*h->col_mv));
+     h->col_type_base = av_mallocz(h->mb_width * h->mb_height);
+-    h->block         = av_mallocz(64 * sizeof(int16_t));
++
++    h->top_cbp         = av_mallocz(h->mb_width);
++    h->top_mb_type     = av_mallocz(h->mb_width);
++    h->top_c_pred_mode = av_mallocz(h->mb_width);
+ 
+     if (!h->top_qp || !h->top_mv[0] || !h->top_mv[1] || !h->top_pred_Y ||
++        !h->top_cbp || !h->top_c_pred_mode || !h->top_mb_type ||
+         !h->top_border_y || !h->top_border_u || !h->top_border_v ||
+-        !h->col_mv || !h->col_type_base || !h->block) {
++        !h->col_mv || !h->col_type_base) {
+         av_freep(&h->top_qp);
++        av_freep(&h->top_cbp);
++        av_freep(&h->top_c_pred_mode);
++        av_freep(&h->top_mb_type);
+         av_freep(&h->top_mv[0]);
+         av_freep(&h->top_mv[1]);
+         av_freep(&h->top_pred_Y);
+@@ -787,7 +859,6 @@ int ff_cavs_init_top_lines(AVSContext *h)
+         av_freep(&h->top_border_v);
+         av_freep(&h->col_mv);
+         av_freep(&h->col_type_base);
+-        av_freep(&h->block);
+         return AVERROR(ENOMEM);
