++        while (!ff_cavs_aec_decode_bypass(&h->aec)) {
++            if (++k > 11) {
++                av_log(h->avctx, AV_LOG_ERROR, "mv_diff out of range\n");
++                return AVERROR_INVALIDDATA;
++            }
++        }
++        v = (1 << k) - 1;
++        while (k--)
++            v += ff_cavs_aec_decode_bypass(&h->aec) << k;
++        v = 3 + 2 * v + even;
