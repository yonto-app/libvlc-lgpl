++static int aec_intra_luma_pred_mode(AVSContext *h, int pred)
++{
++    int v = 0;
++
++    while (v < 4 &&
++           !ff_cavs_aec_decode_decision(&h->aec, AEC_INTRA_LUMA_PRED_MODE + v))
++        v++;
++
++    if (v == 0)
++        return pred;
++    if (v == 4)             /* 4 stands for 0 (9.4.4.2 a) 2)) */
++        v = 0;
++    return v < pred ? v : v + 1;
++}
